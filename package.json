{
  "name": "miweb",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs/site --host 127.0.0.1 --port 4173",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:e2e": "playwright test",
    "browser:install": "playwright install chromium",
    "docs:dev": "vitepress dev docs/site --host 127.0.0.1 --port 4173",
    "docs:build": "vitepress build docs/site",
    "docs:preview": "vitepress preview docs/site --host 127.0.0.1 --port 4173",
    "desktop:dev": "npm run build && electron .",
    "desktop:stage": "node scripts/stage-browser.mjs",
    "desktop:pack": "npm run build && npm run desktop:stage && electron-builder --config electron-builder.config.cjs --dir --win --x64 --publish never",
    "desktop:dist:win": "npm run build && npm run desktop:stage && electron-builder --config electron-builder.config.cjs --win --x64 --publish never",
    "test:desktop": "node tests/desktop-smoke.mjs",
    "editor:dev": "node server/index.mjs",
    "server:start": "node server/index.mjs --production"
  },
  "dependencies": {
    "@babel/parser": "^7.28.4",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-dom": "^3.5.22",
    "@vue/compiler-sfc": "^3.5.22",
    "diff": "^8.0.2",
    "express": "^5.1.0",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "parse5": "^7.3.0",
    "playwright": "^1.56.0",
    "postcss": "^8.5.30",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.1.9",
    "vue": "^3.5.22",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.3",
    "vitepress": "2.0.0-alpha.20"
  },
  "description": "Miweb visual layout editor for AI-generated frontends",
  "author": "NullResot",
  "main": "desktop/main.cjs"
}
